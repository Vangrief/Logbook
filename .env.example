# Logbook — environment configuration
# Copy to .env and adjust. Secrets here are optional: OpenSky credentials are
# normally entered through the in-app Settings page and stored in the database.

# Timezone for the container (affects logs only; flight times are UTC).
TZ=Europe/Zurich

# Path to the SQLite database INSIDE the container. The compose file maps the
# Unraid appdata share to /data, so the default is correct for Unraid.
DATABASE_PATH=/data/flightarchive.db

# --- Authentication --------------------------------------------------------
# REQUIRED: the single shared password used to access the app. The container
# will not start if this is unset.
LOGBOOK_PASSWORD=change-me-to-a-strong-password

# Secret used to sign session cookies. Set a long random string to keep
# sessions valid across restarts; if left blank a random one is generated on
# each startup (existing sessions are invalidated on restart).
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# --- Optional: OpenSky OAuth2 client credentials ---------------------------
# You can paste these into the Settings page after first launch instead.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
